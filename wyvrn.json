{
  "name": "pugixml",
  "version": "1.16.0.0",
  "schemaVersion": 2,
  "kind": "StaticLib",
  "description": "Light-weight, simple and fast XML parser for C++ with XPath support",
  "dependencies": {},
  "build": {
    "system": "cmake",
    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DPUGIXML_BUILD_TESTS=OFF",
      "-DCMAKE_DEBUG_POSTFIX=d",
      "-DCMAKE_RELWITHDEBINFO_POSTFIX=rd",
      "-DCMAKE_MINSIZEREL_POSTFIX=msr"
    ],
    "installDir": "install"
  }
}
